# Maintainer: Agent Shell <agent-shell@example.com>
# Agent Shell — Linux desktop agent shell (§20.2 打包)
# 两个包：agent-shell (daemon+cli+mcp) + agent-shell-rootd (特权代理)

pkgname=('agent-shell' 'agent-shell-rootd')
pkgver=0.1.0
pkgrel=1
arch=('x86_64' 'aarch64')
url="https://github.com/tsic404/agent-shell"
license=('MIT')
# 恒走 BE（--no-default-features）：构建不编译 portal-screencast，无需 PipeWire
# dev 头，故 makedepends 不列 pipewire（运行时依赖仍见 package_agent-shell）。
makedepends=('cargo' 'pkg-config' 'systemd' 'polkit')
source=("agent-shell::git+$url")
sha256sums=('SKIP')

build() {
    cd "$srcdir/agent-shell"
    # D2 编译策略：release profile lto + strip（Cargo.toml [profile.release]）。
    # 恒走 BE：--no-default-features（portal-screencast 关闭，capture 走
    # Screenshot/X11 降级链）。portal-screencast 依赖 libspa-sys 0.10.1 的 bindgen
    # `_libspa_rs` shim（wrap_static_fns 生成），与 release LTO 交互在部分 Arch 类
    # 机器（libpipewire-0.3 = 1.6.8 亦然）链接期报 undefined `spa_*_libspa_rs` /
    # `libspa_rs_type_*`——pre-existing 上游链接问题，与 libpipewire 版本无关，故
    # 取消 ≥0.3.37 门槛，Arch 一律不启用 portal-screencast。
    cargo build --release --no-default-features
}

package_agent-shell() {
    pkgdesc="Agent Shell — Linux desktop agent shell (daemon + CLI + MCP)"
    # pipewire：portal-screencast feature（默认）所需（ScreenCast 流式路径运行时库）。
    depends=('systemd' 'xdg-desktop-portal' 'pipewire' 'hicolor-icon-theme')
    optdepends=('ydotool: input injection fallback (/dev/uinput)'
                'gnome-shell: GNOME Shell Extension host')

    cd "$srcdir/agent-shell"
    # 二进制
    install -Dm755 target/release/agent-shell-daemon "$pkgdir/usr/bin/agent-shell-daemon"
    install -Dm755 target/release/agent-shell "$pkgdir/usr/bin/agent-shell"
    install -Dm755 target/release/agent-shell-mcp "$pkgdir/usr/bin/agent-shell-mcp"
    # systemd user service（§22.2 D1）
    install -Dm644 daemon/agent-shell-daemon.service \
        "$pkgdir/usr/lib/systemd/user/agent-shell-daemon.service"
    # KWin 私有 Wayland 接口授权（§7.6：window_mgmt/fake_input 仅向声明
    # X-KDE-Wayland-Interfaces 的客户端通告）
    install -Dm644 daemon/org.agentshell.Daemon.desktop \
        "$pkgdir/usr/share/applications/org.agentshell.Daemon.desktop"
    # udev rules for ydotool /dev/uinput（§20.3 权限模型）
    install -Dm644 packaging/debian/60-agent-shell-uinput.rules \
        "$pkgdir/usr/lib/udev/rules.d/60-agent-shell-uinput.rules"
    # GNOME Shell Extension（§8.1 系统级部署；用户级启用走 `agent-shell extension enable`）
    install -Dm644 components/compositor/mutter/src/extension.js \
        "$pkgdir/usr/share/gnome-shell/extensions/agent-shell-bridge@tsic.top/extension.js"
    install -Dm644 components/compositor/mutter/src/metadata.json \
        "$pkgdir/usr/share/gnome-shell/extensions/agent-shell-bridge@tsic.top/metadata.json"
}

package_agent-shell-rootd() {
    pkgdesc="Agent Shell rootd — privileged proxy (systemd system unit, polkit whitelist)"
    depends=('polkit' 'systemd')

    cd "$srcdir/agent-shell"
    # rootd 二进制
    install -Dm755 target/release/agent-shell-rootd "$pkgdir/usr/bin/agent-shell-rootd"
    # pkexec 兜底入口（§23.4.1 通道 3）
    install -Dm755 packaging/rootd-pkexec \
        "$pkgdir/usr/lib/agent-shell/rootd-pkexec"
    # systemd system unit（§23.2 系统级单例）
    install -Dm644 rootd/agent-shell-rootd.service \
        "$pkgdir/usr/lib/systemd/system/agent-shell-rootd.service"
    # polkit policy（§23.4.2）
    install -Dm644 packaging/com.agentshell.policy \
        "$pkgdir/usr/share/polkit-1/actions/com.agentshell.policy"
    # D-Bus system policy（允许 rootd 注册 org.agentshell.Rootd）
    install -Dm644 packaging/org.agentshell.Rootd.conf \
        "$pkgdir/usr/share/dbus-1/system.d/org.agentshell.Rootd.conf"
}
